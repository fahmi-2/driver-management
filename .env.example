# Google Maps API Key for Headless Places Autocomplete & Distance Matrix calculation
# Enable "Places API" and "Distance Matrix API" in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Email notifikasi approval (Nodemailer SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASS = App Password (bukan password login)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pool GA <youremail@gmail.com>"
# URL publik aplikasi, dipakai untuk link di email
NEXT_PUBLIC_APP_URL=https://gaspoll.cloud
